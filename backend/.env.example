# copy to .env and fill in

# local postgres from docker-compose.yml
DATABASE_URL=postgresql://audionotes:audionotes@localhost:5432/audionotes

# storage bucket (railway bucket -> Credentials tab)
S3_ENDPOINT_URL=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ADDRESSING_STYLE=path   # needed for minio / supabase
# MAX_UPLOAD_MB=200

GNANI_API_KEY=

# gemini, key from aistudio.google.com
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
# LLM_BACKUP_MODEL=gemini-3.5-flash-lite

# add the vercel url here after deploying (comma separated)
FRONTEND_ORIGINS=http://localhost:3000
