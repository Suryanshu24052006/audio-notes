# copy to .env and fill in

# local postgres from docker-compose.yml
DATABASE_URL=postgresql://audionotes:audionotes@localhost:5432/audionotes

# supabase storage (any s3-compatible bucket works)
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_BUCKET=audio-notes
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

GNANI_API_KEY=

# gemini, key from aistudio.google.com
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
# LLM_BACKUP_MODEL=gemini-3.5-flash-lite

# add the vercel url here after deploying (comma separated)
FRONTEND_ORIGINS=http://localhost:3000
